{
	"name": "@zokugun/vscode.explicit-folding-api",
	"description": "API to register rules to the Explicit-Folding extension",
	"version": "0.3.2",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"license": "MIT",
	"homepage": "https://github.com/zokugun/vscode-explicit-folding-api",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zokugun/vscode-explicit-folding-api.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/vscode-explicit-folding-api/issues"
	},
	"engines": {
		"vscode": "^1.23.0"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/esm/index.mjs",
			"require": "./lib/cjs/index.cjs"
		}
	},
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./lib/cjs/index.d.cts"
			]
		}
	},
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run build:lib",
		"build:lib": "tsc-leda generate",
		"build:package": "tsc-leda update-package && npm run lint:package",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf .src; rimraf lib",
		"compile": "tsc -p src",
		"compile:src": "tsc -p src",
		"lint": "xo",
		"lint:all": "npm audit && npm run lint:package && npm run ci:lint && npm run lint",
		"lint:fix": "xo --fix",
		"lint:package": "fixpack || true",
		"prepack": "npm run build",
		"prepare": "husky; npm run lint:package; fixpack || true",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update",
		"update:deps": "taze --all",
		"watch": "tsc -watch -p src",
		"watch:build": "tsc-watch -p src --onSuccess 'npm run build'",
		"watch:src": "tsc-watch -p src"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"@zokugun/tsc-leda": "0.4.3",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.14.1",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3",
		"xo": "0.60.0"
	},
	"allowScripts": {
		"@zokugun/cli-utils": true
	},
	"keywords": [
		"folding",
		"vscode"
	]
}
